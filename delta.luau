local alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

local function rebuildPayload()
    local output = {}
    for index = 1, #chunkOrder do
        output[index] = encodedChunks[chunkOrder[index]]
    end
    return table.concat(output)
end

local function decodeBase64(input)
    input = input:gsub("[^" .. alphabet .. "=]", "")
    local output = {}
    local buffer = 0
    local bits = 0

    for index = 1, #input do
        local symbol = input:sub(index, index)
        if symbol ~= "=" then
            local value = alphabet:find(symbol, 1, true) - 1
            buffer = buffer * 64 + value
            bits = bits + 6
            if bits >= 8 then
                bits = bits - 8
                output[#output + 1] = string.char(math.floor(buffer / 2 ^ bits) % 256)
                buffer = buffer % 2 ^ bits
            end
        end
    end

    return table.concat(output)
end

local function decodeSource(input)
    local bytes = {}
    for index = 1, #input do
        local sourceByte = string.byte(input, index)
        local keyByte = keyBytes[((index - 1) % #keyBytes) + 1]
        bytes[index] = string.char(bit32.bxor(sourceByte, keyByte))
    end
    return table.concat(bytes)
end

local compiler = loadstring or load
assert(compiler, "This environment does not support Luau code loading.")
local chunk, compileError = compiler(decodeSource(decodeBase64(rebuildPayload())))
assert(chunk, compileError)
return chunk()
